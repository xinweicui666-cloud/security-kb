{
  "standardName": "GDPR",
  "standardCode": "EU General Data Protection Regulation",
  "version": "2016/679",
  "description": "欧盟通用数据保护条例，适用于处理欧盟公民个人数据的组织",
  "clauses": [
    { "id": "GDPR-001", "section": "数据处理原则", "clause": "处理个人数据应遵循合法、公平和透明原则", "keywords": ["合法公平", "透明原则", "数据处理原则", "合法处理"] },
    { "id": "GDPR-002", "section": "数据处理原则", "clause": "个人数据的收集应限于特定目的，不得超出必要范围(数据最小化)", "keywords": ["数据最小化", "目的限制", "最小必要", "范围限制", "最小范围"] },
    { "id": "GDPR-003", "section": "数据处理原则", "clause": "个人数据应保持准确和最新，不准确的数据应及时更正或删除", "keywords": ["数据准确", "数据更新", "更正删除", "数据质量"] },
    { "id": "GDPR-004", "section": "数据处理原则", "clause": "个人数据应以可识别数据主体的形式保存，保存期限不得超过必要时间", "keywords": ["存储限制", "留存期限", "数据保存", "保留期限"] },
    { "id": "GDPR-005", "section": "数据处理原则", "clause": "应采取适当的技术和组织措施确保个人数据安全(完整性、保密性)", "keywords": ["数据安全", "技术措施", "组织措施", "安全保护", "保密性"] },
    { "id": "GDPR-006", "section": "数据处理原则", "clause": "数据控制者应负责并能够证明合规性(问责原则)", "keywords": ["问责原则", "合规证明", "数据控制者", "合规记录"] },
    { "id": "GDPR-007", "section": "合法性基础", "clause": "处理个人数据应基于合法基础：同意、合同、法律义务、合法权益、公共利益、保护生命", "keywords": ["合法基础", "处理依据", "同意", "合同", "法律义务"] },
    { "id": "GDPR-008", "section": "同意要求", "clause": "同意应是自由给出的、具体的、明确的和知情同意", "keywords": ["知情同意", "自由同意", "明确同意", "具体同意", "授权"] },
    { "id": "GDPR-009", "section": "同意要求", "clause": "数据主体有权随时撤回同意，撤回应与给予同意一样容易", "keywords": ["撤回同意", "同意撤回", "退出机制", "取消同意"] },
    { "id": "GDPR-010", "section": "特殊类别数据", "clause": "禁止处理特殊类别数据(种族、政治、宗教、健康、性取向等)，除非有特定例外", "keywords": ["特殊类别", "敏感数据", "种族数据", "健康数据", "生物特征"] },
    { "id": "GDPR-011", "section": "数据主体权利", "clause": "数据主体有权访问其个人数据并获取处理信息(访问权)", "keywords": ["访问权", "数据查询", "数据访问", "知情权"] },
    { "id": "GDPR-012", "section": "数据主体权利", "clause": "数据主体有权要求更正不准确的个人数据(更正权)", "keywords": ["更正权", "数据修改", "数据更正", "纠正权"] },
    { "id": "GDPR-013", "section": "数据主体权利", "clause": "数据主体有权要求删除个人数据(被遗忘权/删除权)", "keywords": ["删除权", "被遗忘权", "数据删除", "擦除权"] },
    { "id": "GDPR-014", "section": "数据主体权利", "clause": "数据主体有权限制对其个人数据的处理(限制处理权)", "keywords": ["限制处理", "处理限制", "暂停处理"] },
    { "id": "GDPR-015", "section": "数据主体权利", "clause": "数据主体有权反对对其个人数据的处理(反对权)", "keywords": ["反对权", "拒绝处理", "数据主体权利"] },
    { "id": "GDPR-016", "section": "数据主体权利", "clause": "数据主体有权将其数据从一个控制者转移到另一个(数据可携带权)", "keywords": ["可携带权", "数据转移", "数据导出", "数据迁移"] },
    { "id": "GDPR-017", "section": "自动化决策", "clause": "数据主体有权不受仅基于自动化处理(包括画像)的决策影响", "keywords": ["自动化决策", "画像", "算法决策", "人工介入", "自动化处理"] },
    { "id": "GDPR-018", "section": "数据控制者义务", "clause": "应向数据主体提供清晰透明的隐私信息(隐私政策/声明)", "keywords": ["隐私政策", "隐私声明", "信息告知", "透明通知", "信息披露"] },
    { "id": "GDPR-019", "section": "数据控制者义务", "clause": "应记录所有数据处理活动(数据处理活动记录ROPA)", "keywords": ["处理记录", "ROPA", "活动记录", "处理日志", "数据清单"] },
    { "id": "GDPR-020", "section": "数据控制者义务", "clause": "应指定数据保护官(DPO)，确保其独立行使职责", "keywords": ["数据保护官", "DPO", "隐私官", "合规负责人"] },
    { "id": "GDPR-021", "section": "数据控制者义务", "clause": "应实施数据保护影响评估(DPIA)以识别高风险处理活动", "keywords": ["DPIA", "影响评估", "隐私评估", "风险评估", "隐私影响"] },
    { "id": "GDPR-022", "section": "数据控制者义务", "clause": "应采取适当技术措施实施数据保护原则(隐私设计和默认保护)", "keywords": ["隐私设计", "默认保护", "Privacy by Design", "Privacy by Default", "数据保护设计"] },
    { "id": "GDPR-023", "section": "数据跨境传输", "clause": "向欧盟以外传输个人数据需确保适当保护水平(充分性认定/SCC/BCR)", "keywords": ["跨境传输", "数据出境", "充分性认定", "SCC", "BCR", "标准合同条款"] },
    { "id": "GDPR-024", "section": "安全事件", "clause": "数据泄露应在72小时内向监管机构报告", "keywords": ["数据泄露", "72小时", "事件报告", "泄露报告", "监管报告"] },
    { "id": "GDPR-025", "section": "安全事件", "clause": "数据泄露应对数据主体及时通知，告知风险和采取的措施", "keywords": ["泄露通知", "数据主体通知", "事件通知", "风险告知"] }
  ]
}