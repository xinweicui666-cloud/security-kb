{
  "standardName": "数据安全法",
  "standardCode": "中华人民共和国数据安全法",
  "version": "2021",
  "description": "中华人民共和国数据安全法（2021年9月1日施行）",
  "clauses": [
    { "id": "SJ-001", "section": "数据安全保护义务", "clause": "开展数据处理活动应当依照法律、法规的规定，建立健全全流程数据安全管理制度", "keywords": ["数据安全制度", "全流程管理", "数据处理", "管理制度"] },
    { "id": "SJ-002", "section": "数据安全保护义务", "clause": "开展数据处理活动应当采取相应的技术措施和其他必要措施，保障数据安全", "keywords": ["技术措施", "数据安全", "安全保障", "防护措施"] },
    { "id": "SJ-003", "section": "数据安全保护义务", "clause": "应当加强风险监测，发现数据安全缺陷、漏洞等风险时应当立即采取补救措施", "keywords": ["风险监测", "漏洞", "补救措施", "安全缺陷"] },
    { "id": "SJ-004", "section": "数据安全保护义务", "clause": "发生数据安全事件时应当依法采取处置措施，并向有关主管部门报告", "keywords": ["数据安全事件", "事件处置", "事件报告", "主管部门"] },
    { "id": "SJ-005", "section": "数据分类分级", "clause": "应当根据数据在经济社会发展中的重要程度以及一旦遭到篡改、破坏、泄露或者非法获取、非法利用造成的危害程度，对数据进行分类分级保护", "keywords": ["数据分类", "数据分级", "分级保护", "分类分级"] },
    { "id": "SJ-006", "section": "数据分类分级", "clause": "应当制定重要数据目录，加强对重要数据的保护", "keywords": ["重要数据", "数据目录", "重要数据保护"] },
    { "id": "SJ-007", "section": "重要数据安全", "clause": "开展涉及重要数据的处理活动应当进行数据安全风险评估", "keywords": ["重要数据", "风险评估", "安全评估", "数据处理"] },
    { "id": "SJ-008", "section": "重要数据安全", "clause": "应当定期向有关主管部门报送数据安全风险评估报告", "keywords": ["风险评估报告", "定期报告", "主管部门", "安全评估"] },
    { "id": "SJ-009", "section": "数据跨境传输", "clause": "向境外提供重要数据的，应当通过国家网信部门组织的数据出境安全评估", "keywords": ["数据出境", "跨境传输", "出境安全评估", "数据跨境"] },
    { "id": "SJ-010", "section": "数据安全审查", "clause": "对影响或者可能影响国家安全的数据处理活动应当进行国家安全审查", "keywords": ["安全审查", "国家安全", "数据审查"] },
    { "id": "SJ-011", "section": "数据安全审查", "clause": "非经中华人民共和国主管机关批准，不得向外国司法机构提供存储在中华人民共和国境内的数据", "keywords": ["数据主权", "境外提供", "主管机关批准"] },
    { "id": "SJ-012", "section": "政务数据安全", "clause": "国家建立政务数据安全管理制度，保障政务数据安全", "keywords": ["政务数据", "政务安全", "数据管理制度"] }
  ]
}
