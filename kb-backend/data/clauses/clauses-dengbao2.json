{
  "standardName": "等保2.0",
  "standardCode": "GB/T 22239-2019",
  "version": "2019",
  "description": "信息安全技术 网络安全等级保护基本要求",
  "clauses": [
    { "id": "D2-001", "section": "安全物理环境", "clause": "机房应设置在具有防震、防风和防雨等能力的建筑内", "keywords": ["机房", "物理环境", "防震", "防风", "防雨", "建筑"] },
    { "id": "D2-002", "section": "安全物理环境", "clause": "机房应采取措施防止雨水和地下水对机房的影响", "keywords": ["机房", "防水", "雨水", "地下水", "防潮"] },
    { "id": "D2-003", "section": "安全物理环境", "clause": "机房应设置防雷保安器，防止雷击", "keywords": ["机房", "防雷", "雷击", "接地"] },
    { "id": "D2-004", "section": "安全物理环境", "clause": "机房应设置火灾自动消防系统", "keywords": ["机房", "消防", "火灾", "自动灭火"] },
    { "id": "D2-005", "section": "安全物理环境", "clause": "机房应设置温湿度自动调节设施", "keywords": ["机房", "温湿度", "空调", "环境监控"] },
    { "id": "D2-006", "section": "安全物理环境", "clause": "机房应设置备用电力供应", "keywords": ["机房", "备用电源", "UPS", "电力"] },
    { "id": "D2-007", "section": "安全通信网络", "clause": "应保证网络设备的业务处理能力满足业务高峰期需要", "keywords": ["网络", "带宽", "容量", "性能", "业务高峰"] },
    { "id": "D2-008", "section": "安全通信网络", "clause": "应划分不同的网络区域，并按照方便管理和控制的原则为各网络区域分配地址", "keywords": ["网络", "区域划分", "VLAN", "子网", "地址分配"] },
    { "id": "D2-009", "section": "安全通信网络", "clause": "应避免将重要网络区域部署在网络边界处，重要网络区域与其他网络区域之间应采用技术手段进行隔离", "keywords": ["网络", "隔离", "DMZ", "区域隔离", "边界"] },
    { "id": "D2-010", "section": "安全通信网络", "clause": "应采用密码技术保证通信过程中数据的完整性", "keywords": ["通信", "数据完整性", "密码技术", "加密", "校验"] },
    { "id": "D2-011", "section": "安全通信网络", "clause": "应采用密码技术保证通信过程中数据的保密性", "keywords": ["通信", "数据保密性", "加密", "SSL", "TLS", "VPN"] },
    { "id": "D2-012", "section": "安全区域边界", "clause": "应在网络边界或区域之间部署访问控制设备，并配置访问控制策略", "keywords": ["边界", "防火墙", "访问控制", "ACL", "策略"] },
    { "id": "D2-013", "section": "安全区域边界", "clause": "应能对网络流量进行监测，对网络攻击进行检测和告警", "keywords": ["流量监测", "入侵检测", "IDS", "IPS", "告警", "安全监测"] },
    { "id": "D2-014", "section": "安全区域边界", "clause": "应对进出网络的数据流实现基于应用协议和应用内容的访问控制", "keywords": ["应用层", "应用控制", "WAF", "协议", "深度包检测"] },
    { "id": "D2-015", "section": "安全计算环境", "clause": "应对登录的用户进行身份标识和鉴别，身份标识具有唯一性", "keywords": ["身份鉴别", "登录", "认证", "用户标识", "密码", "MFA"] },
    { "id": "D2-016", "section": "安全计算环境", "clause": "应对登录的用户进行身份鉴别，鉴别信息应具有复杂度要求并定期更换", "keywords": ["密码策略", "复杂度", "定期更换", "身份鉴别", "密码强度"] },
    { "id": "D2-017", "section": "安全计算环境", "clause": "应采用两种或两种以上组合的鉴别技术对用户进行身份鉴别", "keywords": ["双因素", "MFA", "多因素认证", "身份鉴别", "组合认证"] },
    { "id": "D2-018", "section": "安全计算环境", "clause": "应授予管理用户所需的最小权限，实现管理用户的权限分离", "keywords": ["最小权限", "权限分离", "角色管理", "授权", "RBAC"] },
    { "id": "D2-019", "section": "安全计算环境", "clause": "应对重要主体和客体设置安全标记，并控制主体对有安全标记信息资源的操作", "keywords": ["安全标记", "安全标签", "信息分类", "标记管理"] },
    { "id": "D2-020", "section": "安全计算环境", "clause": "应依据安全策略和所有主体和客体设置的安全标记，实施强制访问控制", "keywords": ["强制访问控制", "MAC", "访问控制", "安全策略"] },
    { "id": "D2-021", "section": "安全计算环境", "clause": "应对重要信息资源设置敏感标记，并根据安全策略严格控制用户对有敏感标记信息资源的操作", "keywords": ["敏感标记", "敏感信息", "数据分类", "分级保护"] },
    { "id": "D2-022", "section": "安全计算环境", "clause": "应采用密码技术保证重要数据在传输过程中的完整性", "keywords": ["数据传输", "完整性", "密码技术", "加密", "校验"] },
    { "id": "D2-023", "section": "安全计算环境", "clause": "应采用密码技术保证重要数据在存储过程中的完整性", "keywords": ["数据存储", "完整性", "密码技术", "哈希", "校验"] },
    { "id": "D2-024", "section": "安全计算环境", "clause": "应采用密码技术保证重要数据在传输过程中的保密性", "keywords": ["数据传输", "保密性", "加密", "SSL", "TLS"] },
    { "id": "D2-025", "section": "安全计算环境", "clause": "应采用密码技术保证重要数据在存储过程中的保密性", "keywords": ["数据存储", "保密性", "加密", "磁盘加密", "数据库加密"] },
    { "id": "D2-026", "section": "安全计算环境", "clause": "应对重要数据进行数据备份", "keywords": ["数据备份", "灾备", "备份策略", "恢复"] },
    { "id": "D2-027", "section": "安全计算环境", "clause": "应提供重要数据的本地数据备份与恢复功能", "keywords": ["本地备份", "数据恢复", "备份恢复"] },
    { "id": "D2-028", "section": "安全计算环境", "clause": "应提供异地数据备份功能，利用通信网络将重要数据定时批量传送至备用场地", "keywords": ["异地备份", "远程备份", "容灾"] },
    { "id": "D2-029", "section": "安全计算环境", "clause": "应保护数据处理系统的完整性，提供检测入侵和攻击的能力", "keywords": ["入侵检测", "攻击检测", "主机安全", "EDR", "HIDS"] },
    { "id": "D2-030", "section": "安全计算环境", "clause": "应对恶意代码进行检测和清除", "keywords": ["恶意代码", "防病毒", "病毒检测", "木马", "恶意软件"] },
    { "id": "D2-031", "section": "安全计算环境", "clause": "应对安全漏洞进行发现和修复", "keywords": ["漏洞扫描", "漏洞修复", "补丁", "安全更新"] },
    { "id": "D2-032", "section": "安全计算环境", "clause": "应提供剩余信息保护功能，保证存储空间中的信息在被释放或重新分配前得到完全清除", "keywords": ["剩余信息", "数据清除", "信息销毁", "擦除"] },
    { "id": "D2-033", "section": "安全计算环境", "clause": "应对客体的访问行为进行审计，审计记录应至少包括事件日期、时间、发起者信息、类型和结果", "keywords": ["审计日志", "访问日志", "操作审计", "日志记录"] },
    { "id": "D2-034", "section": "安全计算环境", "clause": "应保护审计记录，防止未预期的删除、修改或覆盖等", "keywords": ["日志保护", "审计保护", "防篡改", "日志归档"] },
    { "id": "D2-035", "section": "安全管理中心", "clause": "应划分出特定的管理区域，对分布在网络中的安全设备或安全组件进行管控", "keywords": ["安全管理", "管理区域", "安全运营", "SOC", "集中管理"] },
    { "id": "D2-036", "section": "安全管理中心", "clause": "应建立安全策略和管理制度，对安全策略的制定、发布、修订进行管理", "keywords": ["安全策略", "管理制度", "策略管理", "制度发布"] },
    { "id": "D2-037", "section": "安全管理中心", "clause": "应对安全机制进行集中管理，包括安全机制的配置、状态监测和策略分发", "keywords": ["集中管理", "安全配置", "状态监测", "策略分发"] },
    { "id": "D2-038", "section": "安全管理机构", "clause": "应设立网络安全管理机构，配备网络安全管理人员", "keywords": ["安全管理机构", "安全人员", "组织架构", "安全岗位"] },
    { "id": "D2-039", "section": "安全管理机构", "clause": "应建立网络安全责任制，明确网络安全责任", "keywords": ["安全责任制", "责任划分", "安全职责"] },
    { "id": "D2-040", "section": "安全管理机构", "clause": "应定期对网络安全工作进行审核和检查", "keywords": ["安全审核", "安全检查", "定期审查", "合规检查"] },
    { "id": "D2-041", "section": "安全建设管理", "clause": "应在信息系统建设过程中进行安全方案设计", "keywords": ["安全方案", "安全设计", "建设安全", "安全规划"] },
    { "id": "D2-042", "section": "安全建设管理", "clause": "应进行安全产品采购和使用管理", "keywords": ["安全产品", "采购管理", "产品选型"] },
    { "id": "D2-043", "section": "安全建设管理", "clause": "应在信息系统建设完成后进行安全测评", "keywords": ["安全测评", "等保测评", "安全评估", "验收测评"] },
    { "id": "D2-044", "section": "安全运维管理", "clause": "应建立日常运维管理制度，对运维活动进行规范", "keywords": ["运维管理", "日常运维", "运维制度", "运维规范"] },
    { "id": "D2-045", "section": "安全运维管理", "clause": "应建立变更管理制度，对系统变更进行审批和控制", "keywords": ["变更管理", "变更审批", "变更控制", "配置变更"] },
    { "id": "D2-046", "section": "安全运维管理", "clause": "应制定应急预案并定期演练", "keywords": ["应急预案", "应急演练", "灾难恢复", "BCP"] },
    { "id": "D2-047", "section": "安全运维管理", "clause": "应定期进行安全漏洞扫描和修复", "keywords": ["漏洞扫描", "漏洞修复", "安全补丁", "渗透测试"] },
    { "id": "D2-048", "section": "安全运维管理", "clause": "应建立安全事件报告和处置管理制度", "keywords": ["安全事件", "事件报告", "事件处置", "应急响应"] }
  ]
}
