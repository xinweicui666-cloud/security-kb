{
  "standardName": "网络安全法",
  "standardCode": "中华人民共和国网络安全法",
  "version": "2017",
  "description": "中华人民共和国网络安全法（2017年6月1日施行）",
  "clauses": [
    { "id": "WL-001", "section": "网络安全保护义务", "clause": "网络运营者应当按照网络安全等级保护制度的要求履行安全保护义务", "keywords": ["等保", "等级保护", "安全保护义务", "等保测评"] },
    { "id": "WL-002", "section": "网络安全保护义务", "clause": "网络运营者应当制定网络安全事件应急预案，及时处置系统漏洞、网络攻击等安全风险", "keywords": ["应急预案", "漏洞处置", "网络攻击", "安全风险", "应急响应"] },
    { "id": "WL-003", "section": "网络安全保护义务", "clause": "网络运营者应当采取技术措施防范计算机病毒和网络攻击、网络侵入等危害网络安全的行为", "keywords": ["防病毒", "网络攻击", "入侵防御", "安全防护", "IDS", "IPS"] },
    { "id": "WL-004", "section": "网络安全保护义务", "clause": "网络运营者应当采取数据分类、重要数据备份和加密等措施", "keywords": ["数据分类", "数据备份", "数据加密", "分级分类"] },
    { "id": "WL-005", "section": "网络安全保护义务", "clause": "网络运营者应当确保其收集的个人信息安全，防止信息泄露、毁损、丢失", "keywords": ["个人信息安全", "信息泄露", "数据保护", "隐私保护"] },
    { "id": "WL-006", "section": "个人信息保护", "clause": "网络运营者收集、使用个人信息，应当遵循合法、正当、必要的原则", "keywords": ["个人信息", "合法正当必要", "信息收集", "最小必要"] },
    { "id": "WL-007", "section": "个人信息保护", "clause": "网络运营者不得泄露、篡改、损毁其收集的个人信息", "keywords": ["信息泄露", "信息篡改", "个人信息保护", "数据安全"] },
    { "id": "WL-008", "section": "个人信息保护", "clause": "个人信息的收集使用应当明示收集使用的目的、方式和范围", "keywords": ["明示同意", "知情同意", "收集目的", "使用范围"] },
    { "id": "WL-009", "section": "网络安全监测预警", "clause": "应当建立健全网络安全监测预警制度", "keywords": ["监测预警", "安全监测", "威胁情报", "安全态势"] },
    { "id": "WL-010", "section": "网络安全监测预警", "clause": "应当及时处置系统漏洞、计算机病毒、网络攻击、网络侵入等安全风险", "keywords": ["漏洞处置", "病毒处置", "攻击处置", "风险处置"] },
    { "id": "WL-011", "section": "网络安全事件处置", "clause": "发生网络安全事件时应当立即启动应急预案，采取补救措施", "keywords": ["安全事件", "应急预案", "事件处置", "补救措施"] },
    { "id": "WL-012", "section": "网络安全事件处置", "clause": "应当向有关主管部门报告网络安全事件", "keywords": ["事件报告", "主管部门", "安全通报"] },
    { "id": "WL-013", "section": "关键信息基础设施", "clause": "关键信息基础设施运营者应当履行更严格的安全保护义务", "keywords": ["关键信息基础设施", "CIIO", "基础设施保护", "重点保护"] },
    { "id": "WL-014", "section": "关键信息基础设施", "clause": "关键信息基础设施运营者应当每年至少进行一次网络安全检测和风险评估", "keywords": ["年度检测", "风险评估", "安全评估", "定期检测"] },
    { "id": "WL-015", "section": "网络产品和服务", "clause": "网络产品和服务应当符合相关国家标准的强制性要求", "keywords": ["产品标准", "国家标准", "安全认证", "合规要求"] }
  ]
}
