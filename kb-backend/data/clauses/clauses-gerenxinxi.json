{
  "standardName": "个人信息保护法",
  "standardCode": "中华人民共和国个人信息保护法",
  "version": "2021",
  "description": "中华人民共和国个人信息保护法（2021年11月1日施行）",
  "clauses": [
    { "id": "GR-001", "section": "个人信息处理规则", "clause": "处理个人信息应当具有明确、合理的目的，应当与处理目的直接相关", "keywords": ["处理目的", "目的限制", "合理目的", "直接相关"] },
    { "id": "GR-002", "section": "个人信息处理规则", "clause": "收集个人信息应当限于实现处理目的的最小范围，不得过度收集个人信息", "keywords": ["最小必要", "最小范围", "过度收集", "数据最小化"] },
    { "id": "GR-003", "section": "个人信息处理规则", "clause": "处理个人信息应当遵循合法、正当、必要和诚信原则", "keywords": ["合法正当必要", "诚信原则", "处理原则"] },
    { "id": "GR-004", "section": "个人信息处理规则", "clause": "处理个人信息应当取得个人的同意，法律、行政法规另有规定的除外", "keywords": ["个人同意", "知情同意", "授权同意", "用户同意"] },
    { "id": "GR-005", "section": "个人信息处理规则", "clause": "处理个人信息前应当以显著方式、清晰易懂的语言真实、准确、完整地告知个人信息处理者信息", "keywords": ["告知义务", "隐私政策", "隐私声明", "信息披露"] },
    { "id": "GR-006", "section": "个人信息处理规则", "clause": "个人有权撤回其同意，个人信息处理者应当提供便捷的撤回同意的方式", "keywords": ["撤回同意", "退出机制", "同意撤回"] },
    { "id": "GR-007", "section": "敏感个人信息", "clause": "处理敏感个人信息应当取得个人的单独同意", "keywords": ["敏感信息", "单独同意", "敏感数据处理", "特殊同意"] },
    { "id": "GR-008", "section": "敏感个人信息", "clause": "处理敏感个人信息应当向个人告知处理的必要性以及对个人权益的影响", "keywords": ["敏感信息", "必要性告知", "权益影响", "风险评估"] },
    { "id": "GR-009", "section": "敏感个人信息", "clause": "只有在具有特定目的和充分必要性并采取严格保护措施的情形下，方可处理敏感个人信息", "keywords": ["敏感信息", "严格保护", "充分必要", "特定目的"] },
    { "id": "GR-010", "section": "个人信息跨境提供", "clause": "向境外提供个人信息应当通过国家网信部门组织的安全评估", "keywords": ["数据出境", "跨境传输", "出境安全评估", "个人信息出境"] },
    { "id": "GR-011", "section": "个人信息跨境提供", "clause": "向境外提供个人信息应当向个人告知境外接收方的名称、联系方式、处理目的和处理方式等", "keywords": ["跨境告知", "境外接收方", "跨境披露"] },
    { "id": "GR-012", "section": "个人信息跨境提供", "clause": "应当取得个人的单独同意方可向境外提供个人信息", "keywords": ["跨境单独同意", "出境同意", "个人信息出境"] },
    { "id": "GR-013", "section": "个人信息主体权利", "clause": "个人有权向个人信息处理者查阅、复制其个人信息", "keywords": ["查阅权", "复制权", "数据可携带", "访问权"] },
    { "id": "GR-014", "section": "个人信息主体权利", "clause": "个人有权请求个人信息处理者更正、补充其个人信息", "keywords": ["更正权", "补充权", "数据修改"] },
    { "id": "GR-015", "section": "个人信息主体权利", "clause": "个人有权请求删除其个人信息，处理者应当删除", "keywords": ["删除权", "被遗忘权", "数据删除"] },
    { "id": "GR-016", "section": "个人信息主体权利", "clause": "个人有权请求个人信息处理者说明其个人信息的处理情况", "keywords": ["说明权", "处理透明", "信息说明"] },
    { "id": "GR-017", "section": "个人信息处理者义务", "clause": "个人信息处理者应当采取相应的加密、去标识化等安全技术措施", "keywords": ["加密", "去标识化", "脱敏", "安全技术措施"] },
    { "id": "GR-018", "section": "个人信息处理者义务", "clause": "个人信息处理者应当制定内部管理制度和操作规程，确定个人信息保护的负责人", "keywords": ["内部管理制度", "保护负责人", "DPO", "隐私官"] }
  ]
}
