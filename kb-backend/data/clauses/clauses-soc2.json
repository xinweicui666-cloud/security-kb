{
  "standardName": "SOC2",
  "standardCode": "AICPA SOC2 TSC",
  "version": "2017",
  "description": "SOC2信任服务标准，涵盖安全、可用性、处理完整性、保密性、隐私性五大类",
  "clauses": [
    { "id": "SOC-001", "section": "安全(Security)", "clause": "应实施逻辑和物理访问控制，限制对系统资源的授权访问", "keywords": ["访问控制", "逻辑访问", "物理访问", "权限管理", "授权"] },
    { "id": "SOC-002", "section": "安全(Security)", "clause": "应建立并维护用户身份识别和认证机制", "keywords": ["身份认证", "用户认证", "MFA", "登录验证", "身份识别"] },
    { "id": "SOC-003", "section": "安全(Security)", "clause": "应实施防火墙和网络安全防护措施", "keywords": ["防火墙", "网络安全", "入侵防护", "网络隔离", "WAF"] },
    { "id": "SOC-004", "section": "安全(Security)", "clause": "应部署恶意软件检测和防护系统", "keywords": ["恶意软件", "防病毒", "反恶意软件", "病毒防护", "恶意代码"] },
    { "id": "SOC-005", "section": "安全(Security)", "clause": "应建立安全事件检测、响应和报告机制", "keywords": ["安全事件", "事件检测", "事件响应", "事件报告", "应急响应"] },
    { "id": "SOC-006", "section": "安全(Security)", "clause": "应实施变更管理流程，确保系统变更受控", "keywords": ["变更管理", "变更控制", "变更审批", "配置变更", "版本控制"] },
    { "id": "SOC-007", "section": "安全(Security)", "clause": "应建立系统漏洞管理流程，及时修复已知漏洞", "keywords": ["漏洞管理", "漏洞修复", "补丁管理", "安全更新", "CVE"] },
    { "id": "SOC-008", "section": "安全(Security)", "clause": "应实施加密措施保护敏感数据", "keywords": ["加密", "数据加密", "密钥管理", "传输加密", "存储加密"] },
    { "id": "SOC-009", "section": "安全(Security)", "clause": "应建立安全策略和标准，并定期评审更新", "keywords": ["安全策略", "安全标准", "策略评审", "安全制度", "策略更新"] },
    { "id": "SOC-010", "section": "安全(Security)", "clause": "应建立安全培训和意识教育计划", "keywords": ["安全培训", "安全意识", "意识教育", "培训计划"] },
    { "id": "SOC-011", "section": "安全(Security)", "clause": "应建立供应商和第三方风险管理流程", "keywords": ["供应商管理", "第三方风险", "供应商评估", "外包管理", "第三方安全"] },
    { "id": "SOC-012", "section": "安全(Security)", "clause": "应建立安全日志记录和监控机制", "keywords": ["日志记录", "安全监控", "审计日志", "日志审计", "SIEM"] },
    { "id": "SOC-013", "section": "安全(Security)", "clause": "应实施环境安全控制(机房、物理设施)", "keywords": ["环境安全", "机房安全", "物理设施", "物理控制", "环境监控"] },
    { "id": "SOC-014", "section": "安全(Security)", "clause": "应建立数据备份和恢复机制", "keywords": ["数据备份", "数据恢复", "灾备", "备份策略", "恢复测试"] },
    { "id": "SOC-015", "section": "可用性(Availability)", "clause": "应确保系统可用性满足业务需求，建立容量规划", "keywords": ["系统可用性", "容量规划", "性能管理", "SLA", "业务连续性"] },
    { "id": "SOC-016", "section": "可用性(Availability)", "clause": "应建立业务连续性和灾难恢复计划", "keywords": ["业务连续性", "灾难恢复", "BCP", "DRP", "容灾"] },
    { "id": "SOC-017", "section": "可用性(Availability)", "clause": "应建立系统监控和告警机制", "keywords": ["系统监控", "告警机制", "性能监控", "可用性监控", "健康检查"] },
    { "id": "SOC-018", "section": "可用性(Availability)", "clause": "应建立系统维护和补丁更新流程", "keywords": ["系统维护", "补丁更新", "运维管理", "维护窗口"] },
    { "id": "SOC-019", "section": "可用性(Availability)", "clause": "应建立冗余和故障转移机制", "keywords": ["冗余", "故障转移", "高可用", "HA", "负载均衡"] },
    { "id": "SOC-020", "section": "处理完整性(Processing Integrity)", "clause": "应确保数据处理的准确性和完整性", "keywords": ["数据完整性", "数据处理", "数据校验", "准确性", "一致性"] },
    { "id": "SOC-021", "section": "处理完整性(Processing integrity)", "clause": "应建立数据输入验证和错误处理机制", "keywords": ["输入验证", "错误处理", "数据校验", "异常处理", "边界检查"] },
    { "id": "SOC-022", "section": "处理完整性(Processing integrity)", "clause": "应建立数据处理审计和追踪机制", "keywords": ["数据审计", "数据追踪", "处理记录", "审计追踪", "数据溯源"] },
    { "id": "SOC-023", "section": "保密性(Confidentiality)", "clause": "应建立数据分类分级机制，识别和保护敏感信息", "keywords": ["数据分类", "数据分级", "敏感信息", "分级保护", "数据标识"] },
    { "id": "SOC-024", "section": "保密性(Confidentiality)", "clause": "应实施加密和脱敏措施保护保密数据", "keywords": ["加密", "脱敏", "数据掩码", "去标识化", "保密保护"] },
    { "id": "SOC-025", "section": "保密性(Confidentiality)", "clause": "应建立保密协议和访问限制机制", "keywords": ["保密协议", "NDA", "访问限制", "保密控制", "信息隔离"] },
    { "id": "SOC-026", "section": "保密性(Confidentiality)", "clause": "应建立数据销毁和留存管理机制", "keywords": ["数据销毁", "数据留存", "数据清除", "信息销毁", "留存期限"] },
    { "id": "SOC-027", "section": "隐私性(Privacy)", "clause": "应建立个人信息收集、使用和共享的告知和同意机制", "keywords": ["个人信息", "知情同意", "隐私声明", "隐私政策", "收集告知"] },
    { "id": "SOC-028", "section": "隐私性(Privacy)", "clause": "应建立数据主体权利响应机制(访问、更正、删除)", "keywords": ["数据主体", "访问权", "删除权", "更正权", "权利响应"] },
    { "id": "SOC-029", "section": "隐私性(Privacy)", "clause": "应建立隐私影响评估(PIA)机制", "keywords": ["隐私影响评估", "PIA", "隐私评估", "隐私风险"] },
    { "id": "SOC-030", "section": "隐私性(Privacy)", "clause": "应建立数据跨境传输的安全保障机制", "keywords": ["数据跨境", "跨境传输", "数据出境", "隐私保护", "跨境合规"] }
  ]
}